# Stage 1: Build runner layout from local source or GitHub repository
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:8.0-noble AS runner-builder

# Set RUNNER_BRANCH to build from remote repo branch/tag. Keep empty to build from local source context.
ARG RUNNER_BRANCH=""

RUN apt-get update -y && apt-get install -y git curl unzip tar bash

WORKDIR /build

# Copy the local context to /build (supports building local modified/uncommitted code)
COPY . .

# If RUNNER_BRANCH is specified, discard local files and clone from the remote repo branch/tag
RUN if [ -n "$RUNNER_BRANCH" ]; then \
        echo "Discarding local build context and cloning from branch: ${RUNNER_BRANCH}" && \
        find . -mindepth 1 -delete && \
        git clone --depth=1 --branch=${RUNNER_BRANCH} https://github.com/google-ml-infra/runner.git .; \
    fi

WORKDIR /build/src
# NOTE: We exclusively build 'Release' binaries for containerized runners. .NET 'Debug' builds are 
# ~3x slower, consume significantly more memory, and remote container live-debugging (vsdbg) is 
# impractical in K8s. 'Release' builds preserve PDB symbol files, ensuring pod logs still output 
# exact file line numbers and method stack traces on exceptions.
ARG TARGETARCH
RUN git config --global --add safe.directory /build \
    && case "$TARGETARCH" in \
        arm64) RUNNER_ARCH="linux-arm64" ;; \
        *)     RUNNER_ARCH="linux-x64" ;; \
    esac \
    && ./dev.sh layout Release ${RUNNER_ARCH}

# Stage 2: Packaging intermediate (base image matches official runner docker image)
FROM mcr.microsoft.com/dotnet/runtime-deps:8.0-noble AS build

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG RUNNER_CONTAINER_HOOKS_VERSION=0.7.0
ARG DOCKER_VERSION=29.5.0
ARG BUILDX_VERSION=0.34.0

RUN apt update -y && apt install curl unzip -y

WORKDIR /actions-runner

# Copy the compiled layout from runner-builder stage
COPY --from=runner-builder /build/_layout .

# Download official container hooks
RUN curl -f -L -o runner-container-hooks.zip https://github.com/actions/runner-container-hooks/releases/download/v${RUNNER_CONTAINER_HOOKS_VERSION}/actions-runner-hooks-k8s-${RUNNER_CONTAINER_HOOKS_VERSION}.zip \
    && unzip ./runner-container-hooks.zip -d ./k8s \
    && rm runner-container-hooks.zip

RUN curl -f -L -o runner-container-hooks.zip https://github.com/actions/runner-container-hooks/releases/download/v0.8.1/actions-runner-hooks-k8s-0.8.1.zip \
    && unzip ./runner-container-hooks.zip -d ./k8s-novolume \
    && rm runner-container-hooks.zip

# Download docker CLI
RUN export RUNNER_ARCH=${TARGETARCH} \
    && if [ "$RUNNER_ARCH" = "amd64" ]; then export DOCKER_ARCH=x86_64 ; fi \
    && if [ "$RUNNER_ARCH" = "arm64" ]; then export DOCKER_ARCH=aarch64 ; fi \
    && curl -fLo docker.tgz https://download.docker.com/${TARGETOS}/static/stable/${DOCKER_ARCH}/docker-${DOCKER_VERSION}.tgz \
    && tar zxvf docker.tgz \
    && rm -rf docker.tgz \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fLo /usr/local/lib/docker/cli-plugins/docker-buildx \
    "https://github.com/docker/buildx/releases/download/v${BUILDX_VERSION}/buildx-v${BUILDX_VERSION}.linux-${TARGETARCH}" \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-buildx

# Final stage
FROM mcr.microsoft.com/dotnet/runtime-deps:8.0-noble

ENV DEBIAN_FRONTEND=noninteractive
ENV RUNNER_MANUALLY_TRAP_SIG=1
ENV ACTIONS_RUNNER_PRINT_LOG_TO_STDOUT=1
ENV ImageOS=ubuntu24

RUN apt update -y \
    && apt install -y --no-install-recommends sudo lsb-release gpg-agent software-properties-common curl jq unzip \
    && rm -rf /var/lib/apt/lists/*

RUN add-apt-repository ppa:git-core/ppa \
    && apt update -y \
    && apt install -y git \
    && rm -rf /var/lib/apt/lists/*

RUN adduser --disabled-password --gecos "" --uid 1001 runner \
    && groupadd docker --gid 123 \
    && usermod -aG sudo runner \
    && usermod -aG docker runner \
    && echo "%sudo   ALL=(ALL:ALL) NOPASSWD:ALL" > /etc/sudoers \
    && echo "Defaults env_keep += \"DEBIAN_FRONTEND\"" >> /etc/sudoers \
    && chmod 777 /home/runner

WORKDIR /home/runner

COPY --chown=runner:docker --from=build /actions-runner .
COPY --from=build /usr/local/lib/docker/cli-plugins/docker-buildx /usr/local/lib/docker/cli-plugins/docker-buildx

RUN install -o root -g root -m 755 docker/* /usr/bin/ && rm -rf docker

USER runner
